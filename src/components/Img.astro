---
import { Image } from 'astro:assets';

interface Props {
  /** Path like "images/foo.jpg" or "/images/foo.jpg" (resolved under src/assets). */
  src: string;
  alt?: string;
  /** responsive: fluid width. fill: covers a .bg-img parent. box: square crop for avatars/icons. */
  layout?: 'responsive' | 'fill' | 'box';
  loading?: 'lazy' | 'eager';
}
const { src, alt = '', layout = 'responsive', loading = 'lazy' } = Astro.props;

const all = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/**/*.{jpg,jpeg,JPG,png}', { eager: true });
const key = '/src/assets/' + src.replace(/^\//, '');
const img = all[key]?.default;
if (!img) console.warn(`[Img] image not found: ${src}`);
---

{img && layout === 'box' && (
  <Image src={img} alt={alt} width={96} height={96} widths={[48, 96, 192]} sizes="48px" fit="cover" loading={loading} />
)}
{img && layout === 'fill' && (
  <Image src={img} alt={alt} widths={[640, 1024, 1600, 2048]} sizes="100vw" loading={loading} style="width:100%;height:100%;object-fit:cover" />
)}
{img && layout === 'responsive' && (
  <Image src={img} alt={alt} widths={[320, 640, 1024, 2048]} sizes="(max-width: 1024px) 100vw, 1024px" loading={loading} style="width:100%;height:auto" />
)}
