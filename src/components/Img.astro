---
import { Image } from 'astro:assets';

interface Props {
  /** Path like "images/foo.jpg" or "/images/foo.jpg" (resolved under src/assets). */
  src: string;
  alt?: string;
  /** responsive: fluid width. fill: covers a positioned parent. box: square crop for avatars/icons. */
  layout?: 'responsive' | 'fill' | 'box';
  loading?: 'lazy' | 'eager';
  class?: string;
}
const { src, alt = '', layout = 'responsive', loading = 'lazy', class: className = '' } = Astro.props;

const all = {
  ...import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/**/*.{jpg,jpeg,JPG,png,webp}', { eager: true }),
  // Pictures kept next to an event's notes: src/content/event-info/<event>/photo.jpg
  ...import.meta.glob<{ default: ImageMetadata }>('/src/content/event-info/**/*.{jpg,jpeg,JPG,png,webp}', { eager: true }),
};
const rel = src.replace(/^\//, '');
// "src/content/event-info/<event>/photo.jpg" is a picture in an event's folder; anything else is under src/assets.
const key = rel.startsWith('src/') ? '/' + rel : '/src/assets/' + rel;
const img = all[key]?.default;
if (!img) console.warn(`[Img] image not found: ${src}`);
---

{img && layout === 'box' && (
  <Image src={img} alt={alt} width={96} height={96} widths={[48, 96, 192]} sizes="48px" fit="cover" loading={loading} class:list={['size-12 rounded-pill object-cover', className]} />
)}
{img && layout === 'fill' && (
  <Image src={img} alt={alt} widths={[640, 1024, 1600, 2048]} sizes="100vw" loading={loading} class:list={['absolute inset-0 h-full w-full object-cover', className]} />
)}
{img && layout === 'responsive' && (
  <Image src={img} alt={alt} widths={[320, 640, 1024, 2048]} sizes="(max-width: 1024px) 100vw, 1024px" loading={loading} class:list={['w-full h-auto', className]} />
)}
