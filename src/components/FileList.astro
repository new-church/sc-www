---
import Img from './Img.astro';
import Button from './Button.astro';
import { fileSection } from '../lib/data';
import { staticHref } from '../lib/site';
interface Props { section: string }
const items = fileSection(Astro.props.section);
const fmt = (d: string | Date) =>
  new Date(d).toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<div class="not-prose my-6 flex flex-col gap-5">
  {items.map((i) => (
    <article class="rounded-lg border border-border-soft bg-surface-card p-6 shadow-card">
      <div class="mb-3 flex items-center gap-3">
        {i.image && <Img src={i.image} alt={i.author ?? ''} layout="box" />}
        <div class="min-w-0">
          <h3 class="m-0 text-h3">{i.title}</h3>
          <p class="m-0 text-sm text-text-muted">
            {i.author}
            {i.date && (
              <>
                {i.author && ' · '}
                <time>{fmt(i.date)}</time>
              </>
            )}
          </p>
        </div>
      </div>
      <audio controls class="mb-3 w-full" preload="none"><source src={staticHref(i.file)} type="audio/mpeg" /></audio>
      {i.description && <div class="prose-site text-sm" set:html={i.description} />}
      <div class="mt-3"><Button size="sm" variant="secondary" href={staticHref(i.file)}>Download</Button></div>
    </article>
  ))}
</div>
