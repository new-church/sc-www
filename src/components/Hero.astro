---
import Img from './Img.astro';
interface Props {
  title: string;
  description?: string;
  heroclass?: string;
  img?: string;
  textBackground?: boolean;
}
const { title, description, heroclass, img, textBackground } = Astro.props;
---

<section class:list={['hero is-bold', heroclass, img ? 'is-medium' : !heroclass ? 'is-primary' : '', 'is-relative']}>
  <div class="hero-body">
    <div class="container is-lv-2">
      <h1 class="title">{title}</h1>
      <h2 class="subtitle">
        <span class:list={{ 'has-text-background has-background-dark-transparent': textBackground }}>{description}</span>
      </h2>
    </div>
  </div>
  {img && (
    <div class="bg-img is-lv-1">
      <Img src={img} alt={title} layout="fill" loading="eager" />
    </div>
  )}
</section>
