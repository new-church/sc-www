---
import Button from './Button.astro';
import { footerMenu, footerResources, site } from '../lib/site';
const year = new Date().getFullYear();
// The signup block is the footer's main call to action; hide it on the signup pages themselves.
const showSignup = !Astro.url.pathname.startsWith('/subscribe');
const link = 'text-violet-200 no-underline hover:text-gold-300';
---

<footer class="bg-gradient-dusk text-text-on-dark mt-24">
  {showSignup && (
    <div class="border-b border-white/10">
      <div class="container-site px-6 md:px-8 py-10 md:py-12 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
        <div class="max-w-[620px]">
          <div class="font-display text-[12px] tracking-eyebrow uppercase text-gold-300 mb-2">Stay in touch</div>
          <div class="font-display font-semibold text-h2 tracking-display text-text-on-dark">Get the Swedenborg Centre enews</div>
          <p class="mt-2 mb-0 text-text-on-dark/80">Events, talks and news by email, and the Candela magazine if you’d like it. Free, and you can unsubscribe at any time.</p>
        </div>
        <Button variant="gold" size="lg" href="/subscribe/" class="self-start md:self-auto shrink-0">Subscribe to the enews</Button>
      </div>
    </div>
  )}
  <div class="container-site px-6 md:px-8 pt-14 pb-10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1.2fr] gap-10">
    <div>
      <div class="font-display font-semibold text-[22px] tracking-[0.06em] mb-2.5">Swedenborg Centre</div>
      <p class="m-0 text-[15px] text-text-on-dark/75 max-w-[340px]">
        Talks, discussion and study groups, and resources on the writings of Emanuel Swedenborg, from Sydney to Australia and beyond.
      </p>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-3 mt-5">
        <a href="https://donorbox.org/swedenborg-centre" class:list={['font-display text-[14px] tracking-[0.04em]', link]} rel="noopener noreferrer" target="_blank">Donate</a>
        <a href={site.facebook} class:list={['font-display text-[14px] tracking-[0.04em]', link]} rel="noopener noreferrer" target="_blank">Facebook</a>
      </div>
    </div>

    <div class="text-[15px] leading-[2]">
      <div class="font-display text-[12px] tracking-eyebrow uppercase text-gold-300 mb-2">Explore</div>
      {footerMenu.map((i) => (<><a href={i.url} class={link}>{i.name}</a><br /></>))}
    </div>

    <div class="text-[15px] leading-[2]">
      <div class="font-display text-[12px] tracking-eyebrow uppercase text-gold-300 mb-2">Resources</div>
      {footerResources.map((i) => (<><a href={i.url} class={link}>{i.name}</a><br /></>))}
    </div>

    <div class="text-[15px] leading-[2]">
      <div class="font-display text-[12px] tracking-eyebrow uppercase text-gold-300 mb-2">Contact</div>
      4 Shirley Rd, Roseville NSW 2069<br />
      <a href="tel:+61294162812" class={link}>+61 2 9416 2812</a><br />
      <a href="mailto:info@swedenborg.com.au" class:list={[link, 'break-all']}>info@swedenborg.com.au</a>
    </div>
  </div>
  <div class="text-center pb-7 font-display text-[12px] tracking-[0.1em] text-text-on-dark/50 px-6">
    &copy; {year} Swedenborg Centre · ✦ ·{' '}
    <a href="/privacy/" class="text-text-on-dark/50 no-underline hover:text-gold-300">Privacy</a>
  </div>
</footer>
