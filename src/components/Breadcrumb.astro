---
interface Props { crumbs: { name: string; url: string }[]; title: string }
const { crumbs, title } = Astro.props;
---

<section class="section has-background-light" style="padding: 0.5rem 1.5rem;">
  <div class="container">
    <nav class="breadcrumb" aria-label="breadcrumbs">
      <ul>
        <li><a href="/">Home</a></li>
        {crumbs.map((c) => <li><a href={c.url}>{c.name}</a></li>)}
        <li class="is-active"><a href="#" aria-current="page">{title}</a></li>
      </ul>
    </nav>
  </div>
</section>
