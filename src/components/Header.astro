---
import Button from './Button.astro';
import { mainMenu, site } from '../lib/site';

interface Props {
  currentPath?: string;
}
const { currentPath = '/' } = Astro.props;

const isActive = (url: string) => (url === '/' ? currentPath === '/' : currentPath.startsWith(url));
const itemActive = (item: (typeof mainMenu)[number]) =>
  isActive(item.url) || Boolean(item.children?.some((c) => isActive(c.url)));

const linkBase = 'font-display font-semibold tracking-[0.03em] no-underline rounded-pill transition-colors duration-150';
const label = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
---

<header id="site-header" class="sticky top-0 z-40 border-b border-border-soft bg-paper/85 backdrop-blur-[12px]">
  <div class="container-site flex items-center gap-3 px-4 sm:px-6 md:px-8 py-2.5 md:py-3">
    <a href="/" class="flex items-center shrink-0 no-underline" aria-label="Swedenborg Centre Australia, home">
      <img src="/images/ssa-logo.png" alt="Swedenborg Centre Australia" width="728" height="216" class="h-9 md:h-10 w-auto" />
    </a>

    <!-- Desktop nav -->
    <nav class="hidden xl:flex items-center gap-0.5 ml-auto" aria-label="Primary">
      {mainMenu.map((item) =>
        item.children ? (
          <div class="relative group">
            <a
              href={item.url}
              class:list={[linkBase, 'inline-flex items-center gap-1 text-[14px] px-3 pt-2 pb-1.5', itemActive(item) ? 'text-accent-primary-strong bg-violet-100' : 'text-text-muted hover:text-text-heading']}
            >
              {label(item.name)}
              <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2 3.5l3 3 3-3" /></svg>
            </a>
            <div class="invisible opacity-0 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100 transition-opacity duration-150 absolute left-0 top-full pt-2 min-w-[190px]">
              <div class="rounded-md border border-border-soft bg-white shadow-card p-1.5 flex flex-col">
                {item.children.map((c) => (
                  <a href={c.url} class="font-display font-semibold text-[14px] tracking-[0.03em] no-underline text-text-muted hover:text-text-heading hover:bg-violet-50 rounded-sm px-3 pt-2 pb-1.5">
                    {label(c.name)}
                  </a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a
            href={item.url}
            class:list={[linkBase, 'text-[14px] px-3 pt-2 pb-1.5', itemActive(item) ? 'text-accent-primary-strong bg-violet-100' : 'text-text-muted hover:text-text-heading']}
            aria-current={isActive(item.url) ? 'page' : undefined}
          >
            {label(item.name)}
          </a>
        ),
      )}
      <a href={site.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="ml-1 inline-flex size-9 items-center justify-center rounded-pill text-violet-700 hover:bg-violet-100">
        <svg class="size-[18px]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.8 1.4-3.8 3.9v2.3H8v3h2.5V21z" /></svg>
      </a>
      <Button variant="gold" size="sm" href="https://donorbox.org/swedenborg-centre" class="ml-2">Donate</Button>
      <Button variant="secondary" size="sm" href="/contact/" class="ml-1.5">Contact</Button>
    </nav>

    <!-- Compact: CTA + menu toggle -->
    <div class="flex items-center gap-1.5 ml-auto xl:hidden">
      <Button variant="gold" size="sm" href="https://donorbox.org/swedenborg-centre" class="!px-3 !pt-2 !pb-1.5 !text-[12px]">Donate</Button>
      <button type="button" id="nav-toggle" class="inline-flex items-center justify-center size-10 rounded-pill text-violet-900 hover:bg-violet-100 transition-colors duration-150" aria-controls="mobile-nav" aria-expanded="false" aria-label="Open menu">
        <svg id="nav-icon-open" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
        <svg id="nav-icon-close" class="hidden" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      </button>
    </div>
  </div>

  <!-- Mobile drawer -->
  <nav id="mobile-nav" class="xl:hidden hidden border-t border-border-soft bg-paper/95 backdrop-blur-[12px] max-h-[calc(100vh-60px)] overflow-y-auto" aria-label="Mobile" hidden>
    <div class="container-site px-4 sm:px-6 py-3 flex flex-col gap-1">
      {mainMenu.map((item) => (
        <>
          <a href={item.url} class:list={[linkBase, 'text-[16px] px-4 py-3', itemActive(item) && !item.children ? 'text-accent-primary-strong bg-violet-100' : 'text-text-muted hover:text-text-heading hover:bg-violet-50']}>{label(item.name)}</a>
          {item.children?.map((c) => (
            <a href={c.url} class={`${linkBase} text-[15px] pl-9 pr-4 py-2.5 text-text-muted hover:text-text-heading hover:bg-violet-50`}>{label(c.name)}</a>
          ))}
        </>
      ))}
      <div class="pt-2 pb-1 px-1 flex flex-col gap-2">
        <Button variant="secondary" size="md" href="/contact/" class="w-full">Contact</Button>
        <Button variant="ghost" size="md" href={site.facebook} class="w-full">Facebook</Button>
      </div>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const panel = document.getElementById('mobile-nav');
  const iconOpen = document.getElementById('nav-icon-open');
  const iconClose = document.getElementById('nav-icon-close');

  function setOpen(open: boolean) {
    if (!toggle || !panel) return;
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    panel.classList.toggle('hidden', !open);
    panel.hidden = !open;
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
    document.body.classList.toggle('overflow-hidden', open);
  }

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  panel?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
  window.matchMedia('(min-width: 1280px)').addEventListener('change', (e) => {
    if (e.matches) setOpen(false);
  });
</script>
