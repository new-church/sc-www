---
import Img from './Img.astro';
import Time from './Time.astro';
import { summary, type CalendarEvent } from '../lib/events';
interface Props { event: CalendarEvent }
const { event: e } = Astro.props;
const href = `/events/${e.slug}/`;
const img = e.info?.data.img;
---

<div class="card is-block">
  <div class="card-content">
    <div class="media">
      {img && (
        <div class="media-left">
          <figure class="image is-48x48 is-rounded"><Img src={img} alt={e.title} layout="box" /></figure>
        </div>
      )}
      <div class="media-content">
        <p class="title is-4"><a href={href}>{e.title}</a></p>
      </div>
    </div>
    <div class="content">
      {summary(e.info?.body ?? e.descriptionText)}
      <br /><br />
      <strong><Time date={e.start} /></strong>
    </div>
  </div>
  {e.zoomlink && (
    <footer class="card-footer"><a href={e.zoomlink} class="card-footer-item" target="_blank">Join Zoom</a></footer>
  )}
</div>
