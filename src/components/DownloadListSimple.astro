---
import { fileSection } from '../lib/data';
import { staticHref } from '../lib/site';
interface Props { section: string }
const items = fileSection(Astro.props.section);
---

<ul class="my-5 list-none rounded-lg border border-border-soft bg-surface-card p-2 shadow-card">
  {items.map((i) => (
    <li class="!mt-0 border-b border-border-soft last:border-b-0">
      <a href={staticHref(i.file)} class="block rounded-sm px-4 py-2.5 no-underline hover:bg-violet-50">{i.title}</a>
    </li>
  ))}
</ul>
