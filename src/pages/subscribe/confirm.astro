---
import Page from '../../layouts/Page.astro';
import { apiPath, listsFor, readToken, signupPath } from '../../lib/signup';

export const prerender = false;

// The link holds the person's details, so never pass its path or token on as a Referer (the next page loads
// Google Analytics): send only the site's origin. Do NOT use 'no-referrer': it makes browsers send "Origin: null" on
// the Confirm form post, and Astro's cross-site check then rejects it ("Cross-site POST form submissions are forbidden").
Astro.response.headers.set('Referrer-Policy', 'strict-origin');

const t = Astro.url.searchParams.get('t') ?? '';
const sub = readToken(t);
const failed = Astro.url.searchParams.get('error') === 'failed';
---

<Page title="Confirm your subscription" noindex>
  {sub ? (
    <div style="max-width: 32rem">
      <p>Hello {sub.first}, press the button to receive:</p>
      <ul>{listsFor(sub.lists).map((l) => <li>{l.label}</li>)}</ul>
      {failed && <div class="notification is-danger is-light" role="alert">Something went wrong saving your subscription. Please press the button to try again.</div>}
      <form method="post" action={apiPath('/confirm')}>
        <input type="hidden" name="t" value={t} />
        <button class="button is-primary" type="submit">Confirm my subscription</button>
      </form>
    </div>
  ) : (
    <p>
      This confirmation link isn’t valid any more. Please{' '}
      <a href={signupPath()}>sign up again</a>{' '}
      and we’ll send a new one.
    </p>
  )}
</Page>
