---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import EventCard from '../components/EventCard.astro';
import { getCollection } from 'astro:content';
import { getEvents, summary } from '../lib/events';
import { candela } from '../lib/data';
import { site, staticHref } from '../lib/site';

// Home shows live events, so it renders on request and is cached at the edge.
export const prerender = false;
Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=3600');

const events = (await getEvents()).slice(0, 3);
const news = (await getCollection('news')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 3);
const latest = candela()[0];
const fmt = (d: Date) => d.toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<Base>
  <main>
    <!-- Hero -->
    <section class="bg-gradient-dawn border-b border-border-soft overflow-hidden">
      <div class="container-site px-6 md:px-8 pt-10 sm:pt-12 md:pt-16 lg:pt-20 pb-10 sm:pb-12 md:pb-16 lg:pb-20">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 md:gap-10 lg:gap-12 xl:gap-16 lg:items-center">
          <div class="lg:col-span-5 text-center md:text-left flex flex-col items-center md:items-start">
            <div class="font-display font-semibold text-eyebrow tracking-eyebrow uppercase text-accent-primary mb-3 md:mb-4">✦ Swedenborg Centre</div>
            <h1 class="m-0 font-light text-hero text-text-heading tracking-display">Explore the spiritual world</h1>
            <p class="mt-5 md:mt-6 mb-0 max-w-[34rem] text-lg text-text-body">
              Useful events, discussions and material about spiritual life and the spiritual world, from the unique experiences and writings of Emanuel Swedenborg.
            </p>
            <p class="mt-3 md:mt-4 mb-0 max-w-[32rem] text-[15px] sm:text-base text-text-muted">
              Our aim is to help us prepare for richer experiences ahead, and to relate Swedenborg’s writings to our lives.
            </p>
            <div class="mt-7 md:mt-8 w-full sm:w-auto flex flex-col sm:flex-row gap-3 items-stretch sm:items-center justify-center md:justify-start">
              <Button size="lg" href="/events/" class="w-full sm:w-auto">What’s on</Button>
              <Button size="lg" variant="secondary" href="/emanuel-swedenborg/" class="w-full sm:w-auto">Who is Swedenborg?</Button>
            </div>
          </div>
          <div class="lg:col-span-7 min-w-0">
            <figure class="relative overflow-hidden rounded-lg bg-violet-100 shadow-card aspect-[5/4] sm:aspect-[16/10] lg:aspect-[5/4] xl:aspect-[4/3]">
              <Img src="images/unsplash/mindy-pongpanik-Uz6kRtgKRjg-unsplash.jpg" alt="" layout="fill" loading="eager" />
            </figure>
          </div>
        </div>
      </div>
    </section>

    <!-- Upcoming events -->
    <section class="container-site px-6 md:px-8 pt-14 md:pt-[72px]">
      <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-3 mb-6">
        <h2 class="m-0 text-h2">Upcoming events</h2>
        <a href="/events/" class="font-display font-semibold text-[15px] no-underline hover:underline">All events →</a>
      </div>
      <p class="mt-0 mb-6 text-text-muted">Join an event on Zoom. Times are shown in Sydney time.</p>
      {events.length === 0 ? (
        <p>No upcoming events are listed right now. Please check back soon.</p>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
          {events.map((e) => <EventCard event={e} />)}
        </div>
      )}
    </section>

    <!-- Swedenborg + Candela -->
    <section class="container-site px-6 md:px-8 pt-14 md:pt-[72px]">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
        <a href="/emanuel-swedenborg/" class="group relative block overflow-hidden rounded-lg shadow-card no-underline min-h-[320px] bg-gradient-dusk">
          <Img src="images/Swedenborg - 7.jpg" alt="Emanuel Swedenborg" layout="fill" class="opacity-45 transition-transform duration-[600ms] ease-[var(--ease-gentle)] group-hover:scale-[1.03]" />
          <div class="relative flex h-full min-h-[320px] flex-col justify-end p-7 text-text-on-dark">
            <div class="font-display text-eyebrow font-semibold uppercase tracking-eyebrow text-gold-300 mb-2.5">Learn more</div>
            <div class="font-display text-h2 font-semibold tracking-display text-text-on-dark">Who is Swedenborg?</div>
            <p class="mt-2 mb-0 text-text-on-dark/85">Swedenborg, afterlife eyewitness: scientist and spiritual explorer.</p>
          </div>
        </a>

        {latest && (
          <Card variant="tint" eyebrow="Candela magazine" title={latest.title}>
            <div class="flex flex-col sm:flex-row gap-5">
              <a href={staticHref(latest.path)} target="_blank" rel="noopener noreferrer" class="block shrink-0 sm:w-40">
                <Img src={latest.image ?? 'images/candelas.jpg'} alt="Candela magazine" class="rounded-md shadow-card" />
              </a>
              <div>
                {latest.description}
                <div class="mt-4 flex flex-wrap gap-3">
                  <Button size="sm" href={staticHref(latest.path)}>Download</Button>
                  <Button size="sm" variant="secondary" href="/candela/">All Candelas</Button>
                </div>
              </div>
            </div>
          </Card>
        )}
      </div>
    </section>

    <!-- News -->
    {news.length > 0 && (
      <section class="container-site px-6 md:px-8 pt-14 md:pt-[72px]">
        <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-3 mb-6">
          <h2 class="m-0 text-h2">News</h2>
          <a href="/news/" class="font-display font-semibold text-[15px] no-underline hover:underline">All news →</a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
          {news.map((n) => (
            <Card interactive href={`/news/${n.id}/`} eyebrow={fmt(n.data.date)} title={n.data.title}>
              {summary(n.body ?? '')}
            </Card>
          ))}
        </div>
      </section>
    )}

    <!-- Contact + mailing list -->
    <section class="container-site px-6 md:px-8 pt-14 md:pt-[72px]">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <Card title="Visit or get in touch" eyebrow="Contact">
          <p class="m-0">
            4 Shirley Rd, Roseville NSW 2069, Australia<br />
            Phone: <a href="tel:+61294162812" class="text-link hover:text-link-hover">+61 2 9416 2812</a><br />
            <a href={`mailto:${site.email}`} class="text-link hover:text-link-hover">{site.email}</a>
          </p>
          <div slot="footer"><Button size="sm" variant="secondary" href="/contact/">Contact details</Button></div>
        </Card>
        <Card variant="dusk" eyebrow="Stay in touch" title="Monthly enews">
          Get Swedenborg Centre news and events by email, and the Candela magazine if you’d like it.
          <div slot="footer"><Button size="sm" variant="gold" href="/subscribe/">Join our mailing list</Button></div>
        </Card>
      </div>
    </section>
  </main>
</Base>
