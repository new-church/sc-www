---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
---

<Base title="Page not found" noindex>
  <main class="container-site px-6 md:px-8 py-20 text-center">
    <div class="font-display font-semibold text-eyebrow tracking-eyebrow uppercase text-accent-primary mb-2.5">✦ 404</div>
    <h1 class="mt-0 text-h1">Page not found</h1>
    <p class="text-lg text-text-muted">We couldn’t find that page. It may have moved.</p>
    <p class="mt-6"><Button href="/">Back to the home page</Button></p>
  </main>
</Base>
