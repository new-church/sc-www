---
import { getCollection, getEntry, render } from 'astro:content';
import Page from '../../layouts/Page.astro';
import { summary } from '../../lib/events';
import Card from '../../components/Card.astro';

const entry = (await getEntry('pages', 'news'))!;
const { Content } = await render(entry);
const d = entry.data;
const posts = (await getCollection('news')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Page title={d.title} description={d.description} width="wide" eyebrow="Latest">
  <div class="max-w-[760px]"><Content /></div>
  <div class="mt-8 grid grid-cols-1 gap-5 md:grid-cols-2">
    {posts.map((p) => (
      <Card interactive href={`/news/${p.id}/`} eyebrow={p.data.date.toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })} title={p.data.title}>
        {p.data.description ? <>{p.data.description}<br /></> : null}
        {summary(p.body ?? '')}
      </Card>
    ))}
  </div>
</Page>
