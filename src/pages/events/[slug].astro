---
import { marked } from 'marked';
import Page from '../../layouts/Page.astro';
import Time from '../../components/Time.astro';
import { getEvent } from '../../lib/events';

export const prerender = false;
const event = await getEvent(Astro.params.slug ?? '');
if (!event) return Astro.redirect('/events/', 302);
Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=3600');

const infoHtml = event.info?.body ? await marked.parse(event.info.body) : '';
---

<Page title={event.title} crumbs={[{ name: 'Events', url: '/events/' }]}>
  <h3>Time: <Time date={event.start} /></h3>
  {infoHtml ? <Fragment set:html={infoHtml} /> : <Fragment set:html={event.descriptionHtml} />}
  {event.zoomlink && (
    <p class="has-text-centered">
      <a href={event.zoomlink} class="button is-link is-uppercase" target="_blank">Join Zoom Meeting</a>
    </p>
  )}
</Page>
