---
import Page from '../../layouts/Page.astro';
import EventCard from '../../components/EventCard.astro';
import EventsCalendar from '../../components/EventsCalendar.astro';
import Pagination from '../../components/Pagination.astro';
import { getEvents, icsUrl } from '../../lib/events';
import { startOfMonthIn } from '../../lib/dates';
import { site } from '../../lib/site';
import TimeZoneControl from '../../components/TimeZoneControl.astro';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=3600');

const PER_PAGE = 16;
// Start from the beginning of this month (in the Centre's zone), a day and a half earlier so the calendar is complete in
// any viewer's zone too (a day boundary can sit up to 14 hours either side).
const monthStart = new Date(startOfMonthIn(new Date(), site.timeZone).getTime() - 36 * 3600_000);
const all = await getEvents({ since: monthStart });
const now = Date.now();
const upcoming = all.filter((e) => e.end.getTime() >= now);

const calendarItems = all.map((e) => ({
  title: e.displayTitle,
  start: e.allDay ? e.start.toISOString().slice(0, 10) : e.start.toISOString(),
  end: e.end.toISOString(),
  allDay: e.allDay,
  cancelled: e.cancelled,
  href: `/events/${e.slug}/`,
}));

const totalPages = Math.max(1, Math.ceil(upcoming.length / PER_PAGE));
const page = Math.min(Math.max(parseInt(Astro.url.searchParams.get('page') ?? '1', 10) || 1, 1), totalPages);
const slice = upcoming.slice((page - 1) * PER_PAGE, page * PER_PAGE);
---

<Page title="Events" description="Talks, discussions and study groups, with times shown in your own time zone." width="wide" eyebrow="What's on">
  <div class="mb-6 max-w-[620px]"><TimeZoneControl /></div>
  <EventsCalendar items={calendarItems} icsUrl={icsUrl} />

  <h2 class="mt-12 mb-5">Upcoming events</h2>
  {slice.length === 0 && <p>No upcoming events are listed right now. Please check back soon.</p>}
  <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
    {slice.map((e) => <EventCard event={e} />)}
  </div>
  <Pagination page={page} totalPages={totalPages} urlFor={(n) => (n === 1 ? '/events/' : `/events/?page=${n}`)} />
</Page>
