# Google Calendar ICS feed (defaults to the Centre's public calendar)
# EVENTS_ICS_URL=https://calendar.google.com/calendar/ical/.../public/basic.ics

# Base URL for audio/PDF files (defaults to https://static.swedenborg.com.au/)
# PUBLIC_STATIC_URL=https://static.swedenborg.com.au/

# Mailing list signup (double opt-in). Production only on Vercel; other environments use Turnstile test keys
# and log the confirmation link instead of sending it (set SIGNUP_LIVE=1 locally to really send and write).
# TURNSTILE_KEYS is "sitekey,secret" from the Cloudflare widget for this site.
TURNSTILE_KEYS=
POSTMARK_TOKEN=
SIGNUP_SECRET=
PLANNING_CENTER_PAT=
PLANNING_CENTER_PAT_SECRET=
# Staff alerts about signups and problems (comma separated). Optional: defaults to the site's info/admin address.
ALERT_EMAIL_TO=
